{
  "name": "@splitmedialabs/devctl",
  "version": "5.0.0",
  "contributors": [
    "Makara Sok",
    "Enrico Suarez <ensu@splitmedialabs.com>",
    "Rokn Hamdan"
  ],
  "description": "Easily start developing in monorepos with docker-compose",
  "main": "dist/cli.js",
  "bin": {
    "devctl": "./bin/devctl.js",
    "devctl-beta": "./bin/devctl-beta.mjs"
  },
  "scripts": {
    "copy": "copyfiles --up 2 src/templates/*.ejs dist/templates",
    "build": "$npm_execpath run copy && tsc -b",
    "dev": "$npm_execpath run copy && tsc -b -w",
    "clean": "rimraf dist/",
    "dist": "$npm_execpath run copy && tsc --sourceMap false",
    "prepare": "$npm_execpath run clean && $npm_execpath run dist"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "readme.md",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SplitmediaLabsLimited/devctl.git"
  },
  "bugs": {
    "url": "https://github.com/SplitmediaLabsLimited/devctl/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@cipherstash/gluegun": "^5.1.2",
    "@expo/spawn-async": "^1.7.0",
    "@google-cloud/secret-manager": "^4.2.1",
    "@inquirer/prompts": "^3.0.2",
    "bluebird": "^3.7.2",
    "chalk": "^5.6.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "concurrently": "^9.2.1",
    "consola": "^3.4.2",
    "cosmiconfig": "^9.0.0",
    "deepmerge": "^4.3.1",
    "dockerode": "^4.0.7",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "fast-glob": "^3.3.3",
    "get-port": "^7.1.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "mustache": "^4.2.0",
    "node_modules-path": "^2.1.0",
    "ora": "^8.2.0",
    "read-package-json": "^7.0.1"
  },
  "devDependencies": {
    "@types/bluebird": "^3.5.38",
    "@types/copyfiles": "^2",
    "@types/ejs": "^3",
    "@types/js-yaml": "^4.0.5",
    "@types/lodash": "^4.14.197",
    "@types/mustache": "^4.2.2",
    "@types/node": "^16",
    "@types/open": "^6.2.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "babel-eslint": "^10.1.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.1.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "volta": {
    "node": "18.20.8"
  },
  "packageManager": "yarn@4.0.0-rc.43"
}
